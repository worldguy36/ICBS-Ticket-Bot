# =============================================================================
# The ICBS Ticket Bot — environment configuration
# Copy this file to `.env` and fill in the values.
# =============================================================================

# --- Discord ---------------------------------------------------------------
# A SEPARATE bot token from the news bot (DISCORD_BOT_TOKEN in the web app's
# env belongs to The ICBS Times). Create a new application in the Discord
# Developer Portal, add a bot, and copy its token here.
DISCORD_BOT_TOKEN=

# The ID of the guild (server) where the ticket bot operates.
DISCORD_GUILD_ID=

# --- Channels --------------------------------------------------------------
# Channel where the ticket panel message (embed + select menu) is posted.
TICKET_PANEL_CHANNEL_ID=

# Channel where ticket open/close logs and transcripts are posted (#ticket-logs).
TICKET_LOG_CHANNEL_ID=

# Discord Channel Category under which ticket channels are created.
TICKET_CATEGORY_ID=

# --- Roles -----------------------------------------------------------------
# Role with full access to ALL tickets (admins).
TICKET_ADMIN_ROLE_ID=

# Comma-separated list of default staff role IDs. Per-category roles (configured
# via the /setup-panel endpoint or the defaults below) override this for that
# category.
TICKET_STAFF_ROLE_IDS=

# Comma-separated list of Head of Support role IDs. Members with these roles
# can use /ticket-promote and /ticket-demote to grant/revoke the Support Staff
# role. Also manageable at runtime via /ticket-head (admin-only).
# Leave empty to fall back to "anyone with Manage Roles permission".
HEAD_OF_SUPPORT_ROLE_IDS=

# --- Service ---------------------------------------------------------------
# Port the ticket bot's HTTP server listens on. Default 3040 (news bot uses 3030).
# IMPORTANT: Do NOT set this to process.env.PORT — that belongs to the Next.js
# web service on Render and will cause EADDRINUSE.
ICBS_BOT_PORT=3040

# Shared secret between the web app and the bot. Must match the web app's
# ICBS_WEBHOOK_SECRET env var. Used to authenticate POST /setup-panel.
ICBS_WEBHOOK_SECRET=

# --- Optional --------------------------------------------------------------
# Brand icon used as the embed author icon / footer icon. Falls back to a
# placeholder if not set.
ICBS_BRAND_ICON_URL=

# Override the per-category staff roles (JSON map of category id -> role id).
# If unset, the default categories below are used and TICKET_STAFF_ROLE_IDS
# is used as the fallback staff role for every category.
# Example: {"general":"123","bug":"456","billing":"789"}
TICKET_CATEGORY_ROLES=
